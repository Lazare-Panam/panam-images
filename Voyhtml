<script>
//DISABLE WEBFLOW SMOOTH SCROLL
var Webflow = Webflow || [];
Webflow.push(function() {
  $(function() {
      $(document).off('click.wf-scroll');
  });
});
  
  
// Scroll navbar
let scrollPos = 0; // Initial state
let docElement = document.documentElement;
let didScroll = false;
const navbar = document.querySelector('.header');

function scrollPage() {
  var yaxis = window.pageYOffset || docElement.scrollTop;
  if (yaxis >= 24) { // 24px offset
    navbar.classList.add('scrolled');
  } else {
    navbar.classList.remove('scrolled');
  }
  didScroll = false;
}
window.addEventListener('scroll', function () {
  if (!didScroll) {
    didScroll = true;
    setTimeout(scrollPage, 50);
  }
});
  
  
// Menu open/close disable/enable scroll
const openBtns = document.querySelectorAll('[data-disablescroll]');
const closeBtns = document.querySelectorAll('[data-enablescroll]');
openBtns.forEach(opBtn => {
  opBtn.addEventListener('click', () => {
    document.body.classList.add('no-scroll');
  });
});
closeBtns.forEach(clBtn => {
  clBtn.addEventListener('click', () => {
    document.body.classList.remove('no-scroll');
  });
});
  
  
// Accordions
if (document.querySelector('.accordion')) {
  const accordions = document.querySelectorAll('.accordion');

  const setMaxHeight = (acc, open) => {
    const content = acc.querySelector('.accordion-content');
    if (!content) return;
    content.style.maxHeight = open ? `${content.scrollHeight}px` : '0px';
  };

  // Init: collapsed unless already .active
  accordions.forEach(acc => {
    const content = acc.querySelector('.accordion-content');
    if (content) content.style.maxHeight = '0px';
    if (acc.classList.contains('active')) setMaxHeight(acc, true);

    const tab = acc.querySelector('.accordion-tab');
    if (!tab) return;

    tab.addEventListener('click', () => {
      const accGroup = acc.closest('.accordion-container');

      // Close all other accordions in the same group
      if (accGroup) {
        accGroup.querySelectorAll('.accordion').forEach(other => {
          if (other !== acc) {
            other.classList.remove('active');
            setMaxHeight(other, false);
          }
        });
      }

      // Toggle clicked accordion
      acc.classList.toggle('active');
      setMaxHeight(acc, acc.classList.contains('active'));
    });
  });
}


// Floating element
function floatingElem (stickyElem, showAfter) {
  const docElement = document.documentElement;
  let didScroll = false;

  function scrollPage2() {
    const yaxis = window.pageYOffset || docElement.scrollTop;
    if (yaxis >= showAfter) {
      stickyElem.classList.add('scrolled');
    } else {
      stickyElem.classList.remove('scrolled');
    }
    didScroll = false;
  }

  window.addEventListener('scroll', function () {
    if (!didScroll) {
      didScroll = true;
      setTimeout(scrollPage2, 50);
    }
  });
}
if (document.querySelector('#floating-cta')) {
  const floatingCta = document.querySelector('#floating-cta');
  let showStickyAfter = window.innerHeight;
  if (floatingCta.dataset.showafter) {
    const targetEl = document.getElementById(floatingCta.dataset.showafter);
    if (targetEl) {
      showStickyAfter = targetEl.getBoundingClientRect().top + window.scrollY - window.innerHeight / 2;
    } else console.log(`Floating CTA error: "${floatingCta.dataset.showafter}" is not a proper ID!`);
  }
  floatingElem(floatingCta, showStickyAfter);
  //console.log(showStickyAfter);
  
  if (document.querySelector('#popup-button')) {
  	const floatingGift = document.querySelector('#popup-button');
    floatingElem(floatingGift, showStickyAfter);
  }
}
  
// Scroll to section
if (document.querySelector("[data-scrollto-link]")) {
  const allScrollLinks = document.querySelectorAll("[data-scrollto-link]");

  allScrollLinks.forEach(link => {
    link.addEventListener("click", (event) => {
      event.preventDefault();

      const scrollSectionId = event.currentTarget.getAttribute("data-scrollto-link");
      const scrollSectionElem = document.getElementById(scrollSectionId);

      if (!scrollSectionElem) {
        console.warn(`ScrollTo Warning: No section found with ID #${scrollSectionId}`);
        return;
      }

      const headerElement = document.querySelector(".header");
      const headerHeight = headerElement ? headerElement.offsetHeight : 0;

      const sectionTop = scrollSectionElem.getBoundingClientRect().top + window.scrollY;
      const scrollToPosition = sectionTop - headerHeight;

      window.scrollTo({
        top: scrollToPosition,
        behavior: "smooth",
      });
    });
  });
}


gsap.registerPlugin(SplitText);
if (document.querySelector("[hero-split]")) {
  document.fonts.ready.then(() => {
    const heroTitles = document.querySelectorAll("[hero-split]");
    heroTitles.forEach(title => {
      const customSpeed = title.getAttribute("hero-split-speed");
      const duration = customSpeed ? parseFloat(customSpeed) : 0.8;

      let h1split = SplitText.create(title, {
        type: "words",
        wordsClass: "h1-word",
      });
      gsap.from(h1split.words, {
        autoAlpha: 0,
        filter: "blur(10px)",
        duration: duration,
        stagger: 0.15,
      });
    });
  });
}
